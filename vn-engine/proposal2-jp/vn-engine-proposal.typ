    node((4.2, 0), $K_3$, name: <k3>, shape: circle, fill: soft),
    edge(<k0>, <k1>, "-|>", [選択肢]),
    edge(<k1>, <k2>, "-|>", [選択肢]),
    edge(<k2>, <x>, "=|>", [$delta$ のみ再生]),
    edge(<x>, <k3>, "-|>", [選択肢]),
    node((3.2, 1), [$f$ を一度評価], name: <f>, stroke: none),
    edge(<x>, <f>, "-|>"),
  ),
  caption: [編集後のプレビュー。スナップショット $K_2$ を復元し、物語コアをカーソルまで再生して、一度だけ描画する。],
